POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
JWT_KEY=change-me-to-a-random-string-of-at-least-32-chars
# Optional: creates an Admin account on startup if no user with this email exists.
# Password must meet the usual rules (6+ chars, with upper, lower, digit and symbol).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
